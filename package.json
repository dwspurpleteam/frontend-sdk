{
  "name": "@dwspurpleteam/plugin-frontend-sdk",
  "version": "0.1.0",
  "description": "Браузерный SDK для frontend-плагинов внутри iframe",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
